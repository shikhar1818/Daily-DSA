#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin >> t;
    while(t--){
        vector<int> arr(3);
        cin >> arr[0] >> arr[1] >> arr[2];
        sort(arr.begin(),arr.end());
        int cnt = 0;
        while(arr[0] != arr[1] && arr[1] != arr[2]){
            arr[2] -= 1;
            arr[0] += 1;
            cnt++;
        }
        cout << cnt << endl;
    }
    return 0;
}